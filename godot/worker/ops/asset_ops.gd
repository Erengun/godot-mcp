extends RefCounted
## UIDs, resource re-saving and imported-asset verification.

const U = preload("../../addons/godot_mcp/lib/mcp_util.gd")
const C = preload("../../addons/godot_mcp/lib/variant_codec.gd")
const PO = preload("project_ops.gd")


static func ops() -> Dictionary:
	return {"uid_get": uid_get, "uid_resolve": uid_resolve, "resave_resources": resave_resources, "asset_check": asset_check}


static func uid_get(args: Dictionary) -> Variant:
	var path = U.to_res_path(args.get("path"))
	if U.is_fail(path):
		return path
	if not FileAccess.file_exists(path):
		return U.fail("NOT_FOUND", "File does not exist: %s" % path)
	var id := U.read_uid(path)
	var out := {"path": path, "exists": id != ResourceUID.INVALID_ID}
	if id != ResourceUID.INVALID_ID:
		out["uid"] = ResourceUID.id_to_text(id)
	else:
		out["message"] = "No UID assigned yet. Godot assigns UIDs when the editor imports or saves the file (godot_import or update_project_uids)."
	return out


static func uid_resolve(args: Dictionary) -> Variant:
	var uid := str(args.get("uid", ""))
	if not uid.begins_with("uid://"):
		return U.fail("INVALID_ARGUMENT", "uid must start with uid://")
	var id := ResourceUID.text_to_id(uid)
	if id == ResourceUID.INVALID_ID or not ResourceUID.has_id(id):
		return U.fail("NOT_FOUND", "UID %s is not registered (the UID cache is built by the editor; run godot_import)" % uid)
	return {"uid": uid, "path": ResourceUID.get_id_path(id)}


## Re-save scenes and resources so Godot rewrites them in the current format
## (adds missing UIDs, updates references). Fixes upstream issue #102.
static func resave_resources(args: Dictionary) -> Variant:
	var files := []
	PO.collect_files("res://", ["tscn", "tres"], bool(args.get("include_addons", false)), files, clampi(int(args.get("max_files", 5000)), 1, 50000))
	var saved := 0
	var failed := []
	for p in files:
		var r = ResourceLoader.load(p)
		if r == null:
			failed.append({"path": p, "error": "load failed"})
			continue
		var err := U.save_resource(r, p)
		if err != OK:
			failed.append({"path": p, "error": error_string(err)})
		else:
			saved += 1
	var scripts := []
	PO.collect_files("res://", ["gd", "gdshader", "gdshaderinc"], bool(args.get("include_addons", false)), scripts, 50000)
	var missing_uid := []
	for s in scripts:
		if not FileAccess.file_exists(s + ".uid"):
			missing_uid.append(s)
	return {"files_found": files.size(), "saved": saved, "failed": failed, "scripts_without_uid_file": missing_uid, "note": "Script/shader .uid sidecar files are generated by the editor's filesystem scan (godot_import)."}


static func _scene_facts(ps: PackedScene) -> Dictionary:
	var root: Node = ps.instantiate()
	var facts := {"node_count": 0, "mesh_instances": 0, "meshes_missing": 0, "surfaces": 0, "materials": 0, "skeletons": 0, "animation_players": 0, "lights": 0, "cameras": 0}
	var aabb := AABB()
	var first := true
	var stack: Array[Node] = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		facts["node_count"] += 1
		if n is MeshInstance3D:
			facts["mesh_instances"] += 1
			var m := (n as MeshInstance3D).mesh
			if m == null:
				facts["meshes_missing"] += 1
			else:
				facts["surfaces"] += m.get_surface_count()
				for s in m.get_surface_count():
					if m.surface_get_material(s) != null or (n as MeshInstance3D).get_surface_override_material(s) != null:
						facts["materials"] += 1
				var box := m.get_aabb()
				if first:
					aabb = box
					first = false
				else:
					aabb = aabb.merge(box)
		elif n is Skeleton3D:
			facts["skeletons"] += 1
		elif n is AnimationPlayer:
			facts["animation_players"] += 1
		elif n is Light3D:
			facts["lights"] += 1
		elif n is Camera3D:
			facts["cameras"] += 1
		for c in n.get_children():
			stack.append(c)
	root.free()
	facts["mesh_local_aabb_union"] = C.encode(aabb)
	return facts


static func asset_check(args: Dictionary) -> Variant:
	var results := []
	var bad := 0
	for p in args.get("paths", []):
		var path = U.to_res_path(p)
		if U.is_fail(path):
			return path
		var e := {"path": path, "file_exists": FileAccess.file_exists(path), "import_file": FileAccess.file_exists(path + ".import")}
		PO._take_logs()
		if not ResourceLoader.exists(path):
			e["loadable"] = false
			e["reason"] = "not recognised by any loader" if not e["import_file"] else "import metadata exists but the imported data is missing or invalid (re-run godot_import)"
			if e["file_exists"] and not e["import_file"]:
				e["reason"] = "not imported yet (run godot_import) or unsupported format"
			bad += 1
			results.append(e)
			continue
		var r = ResourceLoader.load(path, "", ResourceLoader.CACHE_MODE_IGNORE)
		var diags := PO._take_logs()
		e["loadable"] = r != null
		if r == null:
			bad += 1
			e["diagnostics"] = diags
			results.append(e)
			continue
		e["class"] = r.get_class()
		if r is Texture2D:
			e["size"] = [(r as Texture2D).get_width(), (r as Texture2D).get_height()]
			if (r as Texture2D).get_width() == 0:
				bad += 1
				e["problem"] = "texture has zero size"
		elif r is PackedScene:
			e.merge(_scene_facts(r))
			if e.get("mesh_instances", 0) > 0 and e.get("meshes_missing", 0) == e.get("mesh_instances", 0):
				bad += 1
				e["problem"] = "every MeshInstance3D is missing its mesh"
		elif r is Mesh:
			e["surface_count"] = (r as Mesh).get_surface_count()
			e["aabb"] = C.encode((r as Mesh).get_aabb())
		elif r is AudioStream:
			e["length_seconds"] = (r as AudioStream).get_length()
		elif r is FontFile:
			e["font_name"] = (r as FontFile).get_font_name()
		if not diags.is_empty():
			e["diagnostics"] = diags
		results.append(e)
	return {"checked": results.size(), "problems": bad, "results": results}
